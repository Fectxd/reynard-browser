+    
+    // MARK: - Actions
+    
+    @objc private func handleRefresh() {
+        guard !isRefreshing else {
+            return
+        }
+        setRefreshing(true)
+        onRequestRefresh?()
+    }
+    
+    @objc private func handleClose() {
+        dismiss(animated: true)
+    }
+}
