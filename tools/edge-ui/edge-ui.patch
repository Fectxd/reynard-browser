+final class HomepagePanelRailView: UIView {
+    private enum UX {
+        static let dotSize: CGFloat = 6
+        static let activeDotHeight: CGFloat = 16
+        static let spacing: CGFloat = 6
+    }
+    
+    private let stackView: UIStackView = {
+        let stackView = UIStackView()
+        stackView.translatesAutoresizingMaskIntoConstraints = false
+        stackView.axis = .vertical
+        stackView.alignment = .center
+        stackView.spacing = 6
+        return stackView
+    }()
+    
+    private var dots: [UIView] = []
+    private var heightConstraints: [NSLayoutConstraint] = []
+    private var lastDraggedIndex: Int?
+    
+    /// Called with a page index when the rail is tapped or dragged, so the
+    /// user can jump between pages (e.g. out of a long feed) without scrolling.
+    var onSelectPage: ((Int, Bool) -> Void)?
+    
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        translatesAutoresizingMaskIntoConstraints = false
+        isUserInteractionEnabled = true
+        addSubview(stackView)
+        // Dots stay small; the touch target is a wider, taller strip around them.
+        NSLayoutConstraint.activate([
+            stackView.topAnchor.constraint(equalTo: topAnchor, constant: 12),
+            stackView.bottomAnchor.constraint(equalTo: bottomAnchor, constant: -12),
+            stackView.centerXAnchor.constraint(equalTo: centerXAnchor),
+            widthAnchor.constraint(equalToConstant: 32),
+        ])
+        addGestureRecognizer(UITapGestureRecognizer(target: self, action: #selector(handleTap(_:))))
+        let pan = UIPanGestureRecognizer(target: self, action: #selector(handlePan(_:)))
+        addGestureRecognizer(pan)
+    }
+    
+    private func pageIndex(at point: CGPoint) -> Int? {
+        guard !dots.isEmpty else {
+            return nil
+        }
+        let y = convert(point, to: stackView).y
+        var best = 0
+        var bestDistance = CGFloat.greatestFiniteMagnitude
+        for (index, dot) in dots.enumerated() {
+            let distance = abs(dot.frame.midY - y)
+            if distance < bestDistance {
+                bestDistance = distance
+                best = index
+            }
+        }
+        return best
+    }
+    
+    @objc private func handleTap(_ recognizer: UITapGestureRecognizer) {
+        guard let index = pageIndex(at: recognizer.location(in: self)) else {
+            return
+        }
+        onSelectPage?(index, true)
+    }
+    
+    @objc private func handlePan(_ recognizer: UIPanGestureRecognizer) {
+        switch recognizer.state {
+        case .began, .changed:
+            guard let index = pageIndex(at: recognizer.location(in: self)),
+                  index != lastDraggedIndex else {
+                return
+            }
+            lastDraggedIndex = index
+            onSelectPage?(index, true)
+        default:
+            lastDraggedIndex = nil
+        }
+    }
+    
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+    
+    func configure(pageCount: Int) {
+        for dot in dots {
+            dot.removeFromSuperview()
+        }
+        dots.removeAll()
+        heightConstraints.removeAll()
+        
+        guard pageCount > 1 else {
+            isHidden = true
+            return
+        }
+        
+        isHidden = false
+        for _ in 0..<pageCount {
+            let dot = UIView()
+            dot.translatesAutoresizingMaskIntoConstraints = false
+            dot.layer.cornerRadius = UX.dotSize / 2
+            dot.layer.cornerCurve = .continuous
+            dot.backgroundColor = EdgeHomepagePalette.tertiaryText
+            dot.widthAnchor.constraint(equalToConstant: UX.dotSize).isActive = true
+            let height = dot.heightAnchor.constraint(equalToConstant: UX.dotSize)
+            height.isActive = true
+            heightConstraints.append(height)
+            stackView.addArrangedSubview(dot)
+            dots.append(dot)
+        }
+        update(progress: 0)
+    }
+    
+    func update(progress: CGFloat) {
+        guard !dots.isEmpty else {
+            return
+        }
+        
+        for (index, dot) in dots.enumerated() {
+            let distance = abs(progress - CGFloat(index))
+            let isActive = distance < 0.5
+            dot.backgroundColor = isActive ? EdgeHomepagePalette.accent : EdgeHomepagePalette.tertiaryText
+            heightConstraints[index].constant = isActive ? UX.activeDotHeight : UX.dotSize
+            dot.layer.cornerRadius = UX.dotSize / 2
+        }
+    }
+}
