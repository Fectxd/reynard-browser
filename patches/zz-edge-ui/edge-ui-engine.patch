+  // Edge UI: in-page developer tools (Eruda), the mobile stand-in for F12.
+  // Shows the panel if it is already loaded, otherwise inserts its script.
+  edgeShowDevTools(aUrl) {
+    const win = this.contentWindow;
+    const doc = win?.document;
+    if (!doc) {
+      return "no-document";
+    }
+    const page = win.wrappedJSObject;
+    if (page.eruda) {
+      try {
+        page.eruda.init();
+      } catch (e) {}
+      page.eruda.show();
+      return "shown";
+    }
+    const script = doc.createElement("script");
+    script.src = aUrl;
+    script.addEventListener("load", () => {
+      try {
+        win.wrappedJSObject.eruda.init();
+        win.wrappedJSObject.eruda.show();
+      } catch (e) {
+        win.alert("开发者面板初始化失败：" + e);
+      }
+    });
+    script.addEventListener("error", () => {
+      win.alert("开发者面板加载失败（网络或页面安全策略限制）");
+    });
+    (doc.head || doc.documentElement).appendChild(script);
+    return "loading";
+  }
