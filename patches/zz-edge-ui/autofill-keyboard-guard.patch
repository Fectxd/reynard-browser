diff --git a/widget/uikit/GeckoEditableSupport.mm b/widget/uikit/GeckoEditableSupport.mm
index 7c13120..41103dc 100644
--- a/widget/uikit/GeckoEditableSupport.mm
+++ b/widget/uikit/GeckoEditableSupport.mm
@@ -4251,7 +4251,21 @@ NS_IMETHODIMP AutofillListener::OnEvent(const nsAString& aEvent,
       [keyboard respondsToSelector:@selector(keyboardStateManager)]
           ? (id<GeckoKeyboardAutofillState>)[keyboard keyboardStateManager]
           : (id<GeckoKeyboardAutofillState>)keyboard;
-  [keyboardState.autofillController.autofillGroup removeObjectsForKeys:@[
+  // Edge UI: these are private UIKit classes whose shape differs between
+  // iPadOS versions; check each remaining step instead of crashing with an
+  // unrecognized selector when a login field gets focus.
+  if (![keyboardState respondsToSelector:@selector(autofillController)]) {
+    return;
+  }
+  id autofillController = [keyboardState autofillController];
+  if (![autofillController respondsToSelector:@selector(autofillGroup)]) {
+    return;
+  }
+  id autofillGroup = [autofillController autofillGroup];
+  if (![autofillGroup respondsToSelector:@selector(removeObjectsForKeys:)]) {
+    return;
+  }
+  [autofillGroup removeObjectsForKeys:@[
     UITextContentTypeUsername, UITextContentTypePassword,
     UITextContentTypeOneTimeCode
   ]];
