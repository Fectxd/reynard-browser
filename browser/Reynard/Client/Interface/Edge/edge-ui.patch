+        setOverlayDismissViewVisible(presentation != .hidden)
+        overlayContentView.setPresentation(presentation, animated: animated) { [weak self] in
+            self?.setOverlayDismissViewVisible(presentation != .hidden)
+            completion?()
+        }
+    }
