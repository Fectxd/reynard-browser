diff --git a/browser/Reynard/Client/Interface/Edge/BrowserViewController+EdgeLibraryPanel.swift b/browser/Reynard/Client/Interface/Edge/BrowserViewController+EdgeLibraryPanel.swift
new file mode 100644
index 0000000..8d2e5be
--- /dev/null
+++ b/browser/Reynard/Client/Interface/Edge/BrowserViewController+EdgeLibraryPanel.swift
@@ -0,0 +1,122 @@
+//
+//  BrowserViewController+EdgeLibraryPanel.swift
+//  Reynard
+//
+//  Created by Edge UI instrumentation.
+//
+//  Hosts the Edge right side-by-side Library panel on the wide (pad) layout.
+//  While the panel is open the web content's trailing edge is pulled in by the
+//  panel width (see BrowserViewController.setEdgeLibraryContentTrailingInset)
+//  so the content shifts left and the panel sits side-by-side on the right.
+//  The panel is only ever shown when the layout is pad; narrow/phone keeps the
+//  classic full-screen modal library (presentLibrary). Opening a web page from
+//  a bookmark / history row collapses the panel.
+//
+
+import UIKit
+
+extension BrowserViewController {
+
+    /// Presents the side-by-side library panel (pad only) or falls back to the
+    /// classic full-screen modal (phone / narrow). If the panel is already open
+    /// it just switches to the requested section.
+    func presentEdgeLibraryPanel(section: LibrarySection, animated: Bool = true) {
+        toolbarController.reset()
+        browserChrome.dismissActionBar(animated: false)
+        guard canHostEdgeLibraryPanel else {
+            presentLibrary(initialSection: section)
+            return
+        }
+
+        if let panel = edgeLibraryPanel {
+            panel.showSection(section)
+            return
+        }
+
+        let panel = EdgeLibrarySidePanelController()
+        panel.onClose = { [weak self] in
+            self?.dismissEdgeLibraryPanel(animated: true)
+        }
+
+        addChild(panel)
+        panel.view.translatesAutoresizingMaskIntoConstraints = false
+        view.addSubview(panel.view)
+        NSLayoutConstraint.activate([
+            panel.view.topAnchor.constraint(equalTo: browserChrome.topToolbarBottomAnchor),
+            panel.view.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+            panel.view.bottomAnchor.constraint(equalTo: view.bottomAnchor),
+            panel.view.widthAnchor.constraint(equalToConstant: EdgeLibrarySidePanelController.panelWidth),
+        ])
+        panel.didMove(toParent: self)
+        edgeLibraryPanel = panel
+
+        panel.showSection(section)
+        setEdgeLibraryContentTrailingInset(EdgeLibrarySidePanelController.panelWidth)
+        // Appear in place without the fly-in / slide animation: apply the first
+        // layout synchronously so the panel and content inset both pop into their
+        // final geometry.
+        view.layoutIfNeeded()
+    }
+
+    /// Dismisses the side-by-side library panel, restoring the content to full
+    /// width. No-op when the panel is not open.
+    func dismissEdgeLibraryPanel(animated: Bool = true) {
+        guard let panel = edgeLibraryPanel else {
+            return
+        }
+        let removePanel = {
+            panel.willMove(toParent: nil)
+            panel.view.removeFromSuperview()
+            panel.removeFromParent()
+        }
+        if animated {
+            setEdgeLibraryContentTrailingInset(0)
+            UIView.animate(withDuration: BrowserViewController.layoutAnimationDuration, animations: {
+                self.view.layoutIfNeeded()
+            }, completion: { _ in
+                removePanel()
+            })
+        } else {
+            setEdgeLibraryContentTrailingInset(0)
+            view.layoutIfNeeded()
+            removePanel()
+        }
+        edgeLibraryPanel = nil
+    }
+
+    /// Whether this layout can host the side-by-side panel. Only the wide pad
+    /// layout qualifies; fullscreen media and the tab overview are excluded.
+    var canHostEdgeLibraryPanel: Bool {
+        guard browserLayout.chromeMode == .pad,
+              !isShowingFullscreenMedia,
+              !tabOverview.isPresented else {
+            return false
+        }
+        return true
+    }
+
+    /// Ensures the side panel matches the current layout. Called from layout
+    /// changes (rotation, window resize) so an open panel on the wide layout
+    /// stays put, and collapses itself when the layout stops being wide.
+    func updateEdgeLibraryPanelForLayout() {
+        guard edgeLibraryPanel != nil else {
+            setEdgeLibraryContentTrailingInset(0)
+            return
+        }
+        if canHostEdgeLibraryPanel {
+            setEdgeLibraryContentTrailingInset(EdgeLibrarySidePanelController.panelWidth)
+        } else {
+            dismissEdgeLibraryPanel(animated: false)
+        }
+    }
+
+    /// Called when a web page is opened from inside the panel (bookmarks /
+    /// history rows). Collapses the panel so the content can fill the width.
+    func edgeLibraryPanelDidOpenWebPage() {
+        dismissEdgeLibraryPanel(animated: true)
+    }
+}
+
+private extension BrowserViewController {
+    static var layoutAnimationDuration: TimeInterval { return 0.22 }
+}
diff --git a/browser/Reynard/Client/Interface/Edge/BrowserViewController+EdgeMenu.swift b/browser/Reynard/Client/Interface/Edge/BrowserViewController+EdgeMenu.swift
new file mode 100644
index 0000000..a8dc96d
--- /dev/null
+++ b/browser/Reynard/Client/Interface/Edge/BrowserViewController+EdgeMenu.swift
@@ -0,0 +1,325 @@
+//
+//  BrowserViewController+EdgeMenu.swift
+//  Reynard
+//
+//  Created by Edge UI instrumentation.
+//
+//  Presents the Edge-style overflow menu ("≡") and dispatches each menu item
+//  to the building blocks that already exist in the app. Items without a real
+//  implementation yet are left as icon placeholders inside the menu.
+//
+
+import GeckoView
+import UIKit
+
+extension BrowserViewController {
+
+    /// Presents the Edge-style overflow menu from the "≡" (library) button.
+    func presentEdgeMenu() {
+        toolbarController.reset()
+        browserChrome.dismissActionBar(animated: false)
+
+        let menu = EdgeMenuViewController()
+        menu.onSelect = { [weak self] item in
+            guard let self else { return }
+            // Placeholder items stay open (no action yet); everything else
+            // dismisses the menu first, then runs the action.
+            guard !item.isUnavailablePlaceholder else {
+                return
+            }
+            self.dismiss(animated: true) {
+                self.handleEdgeMenuItem(item)
+            }
+        }
+
+        // Make the desktop/mobile website toggle label reflect the current mode.
+        let isDesktop = tabManager.selectedTab.flatMap { tab in
+            tab.url.flatMap { sessionManager.isDesktopMode(for: $0, tabID: tab.id) }
+        } ?? false
+        menu.titleOverride = { item in
+            guard item == .requestDesktopWebsite else { return nil }
+            return isDesktop ? "查看移动版网页" : "查看桌面网页"
+        }
+        menu.symbolOverride = { item in
+            guard item == .requestDesktopWebsite else { return nil }
+            return isDesktop ? "reynard.smartphone" : "reynard.desktopcomputer"
+        }
+
+        if browserLayout.interfaceIdiom == .pad {
+            menu.modalPresentationStyle = .popover
+            if let popover = menu.popoverPresentationController {
+                popover.sourceView = browserChrome
+                popover.sourceRect = browserChrome.menuButtonAnchorRect()
+                popover.permittedArrowDirections = [.up, .down]
+                popover.backgroundColor = .systemBackground
+            }
+            menu.preferredContentSize = CGSize(width: 375, height: 560)
+        } else {
+            menu.modalPresentationStyle = .pageSheet
+            if #available(iOS 16.0, *), let sheet = menu.sheetPresentationController {
+                // The menu always uses the tall 4-column grid now, so give the
+                // sheet enough height (up to ~92% of screen) to show it without
+                // forcing a scroll; grabber stays for pull-to-dismiss.
+                sheet.detents = [.custom { _ in
+                    let available = menu.view.window?.screen.bounds.height ?? UIScreen.main.bounds.height
+                    let gridHeight = menu.preferredContentSize.height + 48
+                    return min(available * 0.92, gridHeight)
+                }]
+                sheet.prefersGrabberVisible = true
+                sheet.preferredCornerRadius = 18
+            }
+        }
+        present(menu, animated: true)
+    }
+
+    private func handleEdgeMenuItem(_ item: EdgeMenuViewController.Item) {
+        switch item {
+        case .favorites:
+            presentEdgeLibraryPanel(section: .bookmarks)
+        case .history:
+            presentEdgeLibraryPanel(section: .history)
+        case .downloads:
+            presentEdgeLibraryPanel(section: .downloads)
+        case .settings:
+            // Settings always opens as the modal (portrait) settings screen,
+            // in both portrait and landscape — reused as-is.
+            presentEdgeSettings()
+        case .home:
+            openHomepage()
+        case .newInPrivateTab:
+            createNewTab(mode: .private)
+        case .addToFavorites:
+            presentBookmarkEditor(addToFavorites: true)
+        case .requestDesktopWebsite:
+            _ = tabManager.changeWebsiteModeForSelectedTab()
+            refreshAddressBar()
+        case .appearance:
+            presentAppearancePopup()
+        case .clearData:
+            presentClearBrowsingData()
+        case .shareExtension:
+            presentExtensions()
+        case .share:
+            presentShareCurrentPage()
+        case .translate:
+            presentPageTranslation()
+        case .addToPhone:
+            presentQRCodeShare()
+        case .exitBrowser:
+            exitBrowserToBackground()
+        case .findInPage:
+            presentFindInPage()
+        case .fontSize:
+            presentPerSitePageZoom()
+        case .sendToDevice, .downloadPage:
+            // Removed from the displayed menu; kept in the enum for exhaustive
+            // switch coverage, and no-ops if ever selected.
+            break
+        }
+    }
+
+    /// Dismisses the Edge overflow menu when the device layout changes
+    /// (portrait <-> landscape), like Edge. The Settings modal is intentionally
+    /// left open, matching the "except 设置" behaviour.
+    func dismissEdgeMenuOnLayoutChange() {
+        guard let presented = presentedViewController else {
+            return
+        }
+        if presented is EdgeMenuViewController {
+            dismiss(animated: true)
+        }
+    }
+
+    // MARK: - Individual Actions
+
+    /// Settings always opens as the modal (portrait) settings screen in both
+    /// orientations, reusing the same settings UI as portrait.
+    func presentEdgeSettings() {
+        let settingsController = SettingsViewController()
+        presentContentModal(settingsController)
+    }
+
+    /// "深色/浅色模式" — presents an Edge-style popup (deep/light/system),
+    /// shown the same way as the Font size window.
+    private func presentAppearancePopup() {
+        let controller = EdgeAppearanceViewController(
+            current: Prefs.AppearanceSettings.appAppearance
+        )
+        controller.onSelect = { [weak self] appearance in
+            Prefs.AppearanceSettings.appAppearance = appearance
+            AppAppearanceController.apply(appearance)
+        }
+        presentEdgePopup(controller)
+    }
+
+    private func openHomepage() {
+        createNewTab(mode: .regular)
+    }
+
+    private func presentClearBrowsingData() {
+        let controller = ClearBrowsingDataViewController()
+        controller.title = NSLocalizedString("删除数据", comment: "Edge menu")
+        presentContentModal(controller)
+    }
+
+    private func presentExtensions() {
+        let controller = AddonsPreferencesViewController()
+        controller.title = "拓展"
+        presentContentModal(controller)
+    }
+
+    /// Shares the current page (reuses the standard share sheet).
+    private func presentShareCurrentPage() {
+        guard let tab = tabManager.selectedTab,
+              let url = tabManager.shareableURL(for: tab) else {
+            return
+        }
+        let sourceView = browserChrome.sharePopoverSourceView()
+        presentShareSheet(
+            items: [url],
+            sourceView: sourceView,
+            sourceRect: sourceView.bounds
+        )
+    }
+
+    /// Translates the current page, in the spirit of Firefox Android's built-in
+    /// translate action. We open the page through the (key-free) Google
+    /// Translate page-proxy so the user gets a translated copy of the current
+    /// URL in a new tab. A language chooser mirrors the Android target-language
+    /// picker.
+    private func presentPageTranslation() {
+        guard let tab = tabManager.selectedTab,
+              let urlString = tab.url?.trimmingCharacters(in: .whitespacesAndNewlines),
+              let url = URL(string: urlString),
+              url.scheme == "http" || url.scheme == "https" else {
+            return
+        }
+
+        let sheet = UIAlertController(
+            title: "翻译",
+            message: "选择目标语言，在新标签页中打开当前页面的翻译。",
+            preferredStyle: .actionSheet
+        )
+        let languages: [(String, String)] = [
+            ("简体中文", "zh-CN"),
+            ("English", "en"),
+            ("日本語", "ja"),
+            ("한국어", "ko"),
+            ("Français", "fr"),
+            ("Deutsch", "de"),
+            ("Español", "es"),
+            ("Русский", "ru"),
+        ]
+        for (name, code) in languages {
+            sheet.addAction(UIAlertAction(title: name, style: .default) { [weak self] _ in
+                self?.openTranslatedPage(url, to: code)
+            })
+        }
+        sheet.addAction(UIAlertAction(title: "取消", style: .cancel))
+        if let popover = sheet.popoverPresentationController {
+            popover.sourceView = browserChrome
+            popover.sourceRect = browserChrome.menuButtonAnchorRect()
+            popover.permittedArrowDirections = [.up, .down]
+        }
+        present(sheet, animated: true)
+    }
+
+    private func openTranslatedPage(_ url: URL, to targetLanguage: String) {
+        let query = [
+            "sl=auto",
+            "tl=\(targetLanguage)",
+            "u=\(url.absoluteString)",
+        ].joined(separator: "&")
+        guard let translateURL = URL(string: "https://translate.google.com/translate?\(query)") else {
+            return
+        }
+        _ = tabManager.createRegularTab(
+            selecting: true,
+            target: .end,
+            url: translateURL.absoluteString,
+            loadImmediately: true
+        )
+    }
+
+    /// Presents a QR-code share for the current URL, with a field to paste your
+    /// own text and generate a QR of that instead (Firefox Android's QR flow).
+    private func presentQRCodeShare() {
+        let urlString = tabManager.selectedTab.flatMap {
+            $0.url?.trimmingCharacters(in: .whitespacesAndNewlines)
+        } ?? ""
+        let controller = EdgeQRCodeShareViewController(initialText: urlString)
+        presentContentModal(controller)
+    }
+
+    /// "退出浏览器" — background the app, like pressing the Home button.
+    /// Uses the same selector that the app's existing quit flow uses
+    /// (UIApplication suspend), which references a real method so #selector
+    /// compiles.
+    private func exitBrowserToBackground() {
+        UIApplication.shared.perform(#selector(NSXPCConnection.suspend))
+    }
+
+    private func presentFindInPage() {
+        guard tabManager.selectedTab != nil else {
+            return
+        }
+        browserChrome.showActionBar(.findInPage, animated: true)
+    }
+
+    /// Font size is exposed as per-site page zoom, backed by SiteSettingsStore
+    /// so the level is remembered for the current host only.
+    /// Presents the Edge-style Font size window for the current site. The zoom
+    /// level is applied per host by `setSelectedPageZoomLevel`, which persists
+    /// to SiteSettingsStore and updates the live session.
+    private func presentPerSitePageZoom() {
+        guard let selectedTab = tabManager.selectedTab else {
+            return
+        }
+
+        let controller = EdgeFontSizeViewController(
+            level: selectedTab.session.settings.pageZoom.level
+        )
+        controller.onApply = { [weak self] level in
+            self?.setSelectedPageZoomLevel(level)
+        }
+
+        presentEdgePopup(controller)
+    }
+
+    /// Presents an Edge-style popup sheet, shared by the Font-size, Appearance,
+    /// and other small windows. Pad → popover anchored to the menu button;
+    /// phone → a compact pageSheet (detent sized to the content or maxHeight)
+    /// with a grabber.
+    private func presentEdgePopup(_ controller: UIViewController, maxHeight: CGFloat? = nil) {
+        if browserLayout.interfaceIdiom == .pad {
+            controller.modalPresentationStyle = .popover
+            if let popover = controller.popoverPresentationController {
+                popover.sourceView = browserChrome
+                popover.sourceRect = browserChrome.menuButtonAnchorRect()
+                popover.permittedArrowDirections = [.up, .down]
+                popover.backgroundColor = .systemBackground
+            }
+        } else {
+            controller.modalPresentationStyle = .pageSheet
+            if #available(iOS 16.0, *), let sheet = controller.sheetPresentationController {
+                // The sheet detent is measured from the screen bottom. A pageSheet
+                // also reserves a grabber + top inset above the content, so add
+                // clearance so the card is fully visible and not shrunken.
+                let availableHeight = controller.view.window?.screen.bounds.height ?? UIScreen.main.bounds.height
+                let detentHeight: CGFloat
+                if let maxHeight {
+                    detentHeight = maxHeight
+                } else {
+                    detentHeight = min(
+                        controller.preferredContentSize.height + 48,
+                        availableHeight * 0.62
+                    )
+                }
+                sheet.detents = [.custom { _ in detentHeight }]
+                sheet.prefersGrabberVisible = true
+                sheet.preferredCornerRadius = 18
+            }
+        }
+        present(controller, animated: true)
+    }
+}
diff --git a/browser/Reynard/Client/Interface/Edge/EdgeAppearanceViewController.swift b/browser/Reynard/Client/Interface/Edge/EdgeAppearanceViewController.swift
new file mode 100644
index 0000000..1028ec4
--- /dev/null
+++ b/browser/Reynard/Client/Interface/Edge/EdgeAppearanceViewController.swift
@@ -0,0 +1,141 @@
+//
+//  EdgeAppearanceViewController.swift
+//  Reynard
+//
+//  Created by Edge UI instrumentation.
+//
+//  Edge-style "深色/浅色模式" popup, presented the same way as the Font size
+//  window. The user picks one of: 深色 / 浅色 / 跟随系统.
+//
+
+import UIKit
+
+final class EdgeAppearanceViewController: UIViewController {
+
+    private enum UX {
+        static let contentWidth: CGFloat = 300
+        static let contentHeight: CGFloat = 292
+        static let blueTint = UIColor(red: 0.0, green: 0.48, blue: 1.0, alpha: 1.0)
+        static let headerFontSize: CGFloat = 18
+        static let rowFontSize: CGFloat = 16
+        static let rowHeight: CGFloat = 50
+        static let rowSpacing: CGFloat = 8
+        static let topPadding: CGFloat = 28
+        static let bottomPadding: CGFloat = 20
+    }
+
+    /// Invoked when the user picks an appearance; the presenter persists the
+    /// choice and applies it.
+    var onSelect: ((AppAppearance) -> Void)?
+
+    private let titleLabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.text = "深色/浅色模式"
+        label.font = .systemFont(ofSize: UX.headerFontSize, weight: .semibold)
+        label.textColor = .label
+        return label
+    }()
+
+    private let subtitleLabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.text = "选择外观"
+        label.font = .systemFont(ofSize: 13)
+        label.textColor = .secondaryLabel
+        return label
+    }()
+
+    private var optionButtons: [UIButton] = []
+
+    init(current: AppAppearance) {
+        super.init(nibName: nil, bundle: nil)
+        configureOptions(current: current)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        view.backgroundColor = .systemBackground
+        preferredContentSize = CGSize(width: UX.contentWidth, height: UX.contentHeight)
+        configureHierarchy()
+        configureConstraints()
+    }
+
+    private func configureOptions(current: AppAppearance) {
+        let options: [(AppAppearance, String)] = [
+            (.dark, "深色"),
+            (.light, "浅色"),
+            (.system, "跟随系统"),
+        ]
+        for (appearance, title) in options {
+            let button = UIButton(type: .system)
+            button.translatesAutoresizingMaskIntoConstraints = false
+            button.setTitle(title, for: .normal)
+            button.titleLabel?.font = .systemFont(ofSize: UX.rowFontSize, weight: .medium)
+            button.setTitleColor(.label, for: .normal)
+            button.contentHorizontalAlignment = .left
+            button.contentEdgeInsets = UIEdgeInsets(top: 0, left: 14, bottom: 0, right: 14)
+            button.backgroundColor = UIColor.secondarySystemBackground
+            button.layer.cornerRadius = 10
+            button.layer.cornerCurve = .continuous
+            button.layer.borderWidth = 1
+            button.layer.borderColor = (appearance == current ? UX.blueTint : UIColor.clear).cgColor
+            button.tintColor = appearance == current ? UX.blueTint : .clear
+            button.tag = options.firstIndex(where: { $0.0 == appearance }) ?? 0
+            button.addTarget(self, action: #selector(optionTapped(_:)), for: .touchUpInside)
+            optionButtons.append(button)
+        }
+    }
+
+    private func configureHierarchy() {
+        view.addSubview(titleLabel)
+        view.addSubview(subtitleLabel)
+        optionButtons.forEach { view.addSubview($0) }
+    }
+
+    private func configureConstraints() {
+        NSLayoutConstraint.activate([
+            titleLabel.topAnchor.constraint(equalTo: view.topAnchor, constant: UX.topPadding),
+            titleLabel.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: 16),
+            titleLabel.trailingAnchor.constraint(equalTo: view.trailingAnchor, constant: -16),
+
+            subtitleLabel.topAnchor.constraint(equalTo: titleLabel.bottomAnchor, constant: 4),
+            subtitleLabel.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: 16),
+
+            optionButtons[0].topAnchor.constraint(equalTo: subtitleLabel.bottomAnchor, constant: 18),
+        ])
+
+        var previousButton: UIButton?
+        for button in optionButtons {
+            NSLayoutConstraint.activate([
+                button.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: 16),
+                button.trailingAnchor.constraint(equalTo: view.trailingAnchor, constant: -16),
+                button.heightAnchor.constraint(equalToConstant: UX.rowHeight),
+            ])
+            if let previousButton {
+                NSLayoutConstraint.activate([
+                    button.topAnchor.constraint(equalTo: previousButton.bottomAnchor, constant: UX.rowSpacing),
+                ])
+            }
+            previousButton = button
+        }
+        if let last = optionButtons.last {
+            NSLayoutConstraint.activate([
+                last.bottomAnchor.constraint(lessThanOrEqualTo: view.bottomAnchor, constant: -UX.bottomPadding),
+            ])
+        }
+    }
+
+    @objc private func optionTapped(_ sender: UIButton) {
+        let options: [AppAppearance] = [.dark, .light, .system]
+        guard options.indices.contains(sender.tag) else {
+            return
+        }
+        onSelect?(options[sender.tag])
+        dismiss(animated: true)
+    }
+}
diff --git a/browser/Reynard/Client/Interface/Edge/EdgeFontSizeViewController.swift b/browser/Reynard/Client/Interface/Edge/EdgeFontSizeViewController.swift
new file mode 100644
index 0000000..a2f1112
--- /dev/null
+++ b/browser/Reynard/Client/Interface/Edge/EdgeFontSizeViewController.swift
@@ -0,0 +1,261 @@
+//
+//  EdgeFontSizeViewController.swift
+//  Reynard
+//
+//  Created by Edge UI instrumentation.
+//
+//  Edge-style "Font size" (字体大小) popup. It reads and writes the current
+//  site's page-zoom level (stored per host in SiteSettingsStore) and lets the
+//  user drag a slider between the smallest and the largest supported level.
+//
+//  Layout follows Edge:
+//    < 字体大小                     (header: back chevron + title)
+//      ─────────────────────────
+//      网页字体大小                 (section label)
+//      A  ────●──────  A           (small A, slider, large A)
+//             100%                 (current level)
+//      此字号仅适用于此域中的网站。  (footer note)
+//
+
+import UIKit
+
+final class EdgeFontSizeViewController: UIViewController {
+
+    private enum UX {
+        static let contentWidth: CGFloat = 360
+        // Natural content height is ~198pt (52 header + 0.5 divider + 12 +
+        // section + 12 + slider + 6 + percent + 14 + note + ~12 bottom). The
+        // old 236 left a tall empty band under the footer note. 200 keeps a
+        // small cushion while removing the dead space.
+        static let contentHeight: CGFloat = 200
+        static let blueTint = UIColor(red: 0.0, green: 0.48, blue: 1.0, alpha: 1.0)
+        static let smallAFontSize: CGFloat = 11
+        static let largeAFontSize: CGFloat = 26
+        static let percentFontSize: CGFloat = 17
+        static let noteFontSize: CGFloat = 12
+        static let sectionFontSize: CGFloat = 14
+        static let headerFontSize: CGFloat = 18
+    }
+
+    /// Invoked with the newly selected level; the presenter applies it per-site
+    /// (persisting to SiteSettingsStore and updating the session).
+    var onApply: ((Int) -> Void)?
+
+    /// The zoom levels, in ascending order. The slider maps continuously to the
+    /// index of this array so every step is evenly spaced; the value snaps to
+    /// the nearest level on change (and on release).
+    private let levels = PageZoomLevels.all
+
+    private var currentLevel: Int = Prefs.BrowsingSettings.defaultPageZoomLevel
+
+    // MARK: - View Construction
+
+    private let headerView: UIView = {
+        let view = UIView()
+        view.translatesAutoresizingMaskIntoConstraints = false
+        return view
+    }()
+
+    private lazy var backButton: UIButton = {
+        let button = UIButton(type: .system)
+        button.translatesAutoresizingMaskIntoConstraints = false
+        button.setImage(UIImage(systemName: "chevron.backward"), for: .normal)
+        button.tintColor = UX.blueTint
+        button.addTarget(self, action: #selector(backTapped), for: .touchUpInside)
+        return button
+    }()
+
+    private let titleLabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.text = "字体大小"
+        label.font = .systemFont(ofSize: UX.headerFontSize, weight: .semibold)
+        label.textColor = .label
+        return label
+    }()
+
+    private let topDivider: UIView = {
+        let view = UIView()
+        view.translatesAutoresizingMaskIntoConstraints = false
+        view.backgroundColor = .separator
+        return view
+    }()
+
+    private let sectionLabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.text = "网页字体大小"
+        label.font = .systemFont(ofSize: UX.sectionFontSize, weight: .regular)
+        label.textColor = .label
+        return label
+    }()
+
+    private let smallALabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.text = "A"
+        label.font = .systemFont(ofSize: UX.smallAFontSize, weight: .medium)
+        label.textColor = .secondaryLabel
+        return label
+    }()
+
+    private lazy var slider: UISlider = {
+        let slider = UISlider()
+        slider.translatesAutoresizingMaskIntoConstraints = false
+        slider.minimumValue = 0
+        slider.maximumValue = Float(levels.count - 1)
+        slider.isContinuous = true
+        slider.tintColor = UX.blueTint
+        slider.addTarget(self, action: #selector(sliderChanged(_:)), for: .valueChanged)
+        slider.addTarget(
+            self,
+            action: #selector(sliderReleased(_:)),
+            for: [.touchUpInside, .touchUpOutside, .touchCancel]
+        )
+        return slider
+    }()
+
+    private let largeALabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.text = "A"
+        label.font = .systemFont(ofSize: UX.largeAFontSize, weight: .medium)
+        label.textColor = .label
+        label.setContentHuggingPriority(.required, for: .horizontal)
+        label.setContentCompressionResistancePriority(.required, for: .horizontal)
+        return label
+    }()
+
+    private let percentLabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.font = .systemFont(ofSize: UX.percentFontSize, weight: .medium)
+        label.textColor = .label
+        label.textAlignment = .center
+        return label
+    }()
+
+    private let noteLabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.text = "此字号仅适用于此域中的网站。"
+        label.font = .systemFont(ofSize: UX.noteFontSize, weight: .regular)
+        label.textColor = .secondaryLabel
+        label.textAlignment = .center
+        label.numberOfLines = 0
+        return label
+    }()
+
+    // MARK: - Lifecycle
+
+    init(level: Int? = nil) {
+        if let level, levels.contains(level) {
+            currentLevel = level
+        }
+        super.init(nibName: nil, bundle: nil)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        view.backgroundColor = .systemBackground
+        preferredContentSize = CGSize(width: UX.contentWidth, height: UX.contentHeight)
+        configureHierarchy()
+        configureConstraints()
+        refreshUI()
+    }
+
+    // MARK: - Setup
+
+    private func configureHierarchy() {
+        headerView.addSubview(backButton)
+        headerView.addSubview(titleLabel)
+        [headerView, topDivider, sectionLabel, smallALabel, slider, largeALabel, percentLabel, noteLabel].forEach {
+            view.addSubview($0)
+        }
+    }
+
+    private func configureConstraints() {
+        NSLayoutConstraint.activate([
+            headerView.topAnchor.constraint(equalTo: view.topAnchor),
+            headerView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
+            headerView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+            headerView.heightAnchor.constraint(equalToConstant: 52),
+
+            backButton.leadingAnchor.constraint(equalTo: headerView.leadingAnchor, constant: 12),
+            backButton.centerYAnchor.constraint(equalTo: headerView.centerYAnchor),
+            backButton.widthAnchor.constraint(equalToConstant: 36),
+            backButton.heightAnchor.constraint(equalToConstant: 36),
+
+            titleLabel.leadingAnchor.constraint(equalTo: backButton.trailingAnchor, constant: 6),
+            titleLabel.centerYAnchor.constraint(equalTo: headerView.centerYAnchor),
+            titleLabel.trailingAnchor.constraint(lessThanOrEqualTo: headerView.trailingAnchor, constant: -12),
+
+            topDivider.topAnchor.constraint(equalTo: headerView.bottomAnchor),
+            topDivider.leadingAnchor.constraint(equalTo: view.leadingAnchor),
+            topDivider.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+            topDivider.heightAnchor.constraint(equalToConstant: 0.5),
+
+            sectionLabel.topAnchor.constraint(equalTo: topDivider.bottomAnchor, constant: 12),
+            sectionLabel.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: 20),
+            sectionLabel.trailingAnchor.constraint(lessThanOrEqualTo: view.trailingAnchor, constant: -20),
+
+            smallALabel.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: 20),
+            smallALabel.centerYAnchor.constraint(equalTo: slider.centerYAnchor),
+
+            slider.topAnchor.constraint(equalTo: sectionLabel.bottomAnchor, constant: 12),
+            slider.leadingAnchor.constraint(equalTo: smallALabel.trailingAnchor, constant: 10),
+            slider.trailingAnchor.constraint(equalTo: largeALabel.leadingAnchor, constant: -10),
+
+            largeALabel.trailingAnchor.constraint(equalTo: view.trailingAnchor, constant: -20),
+            largeALabel.centerYAnchor.constraint(equalTo: slider.centerYAnchor),
+
+            percentLabel.topAnchor.constraint(equalTo: slider.bottomAnchor, constant: 6),
+            percentLabel.centerXAnchor.constraint(equalTo: view.centerXAnchor),
+
+            noteLabel.topAnchor.constraint(equalTo: percentLabel.bottomAnchor, constant: 14),
+            noteLabel.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: 20),
+            noteLabel.trailingAnchor.constraint(equalTo: view.trailingAnchor, constant: -20),
+            noteLabel.bottomAnchor.constraint(lessThanOrEqualTo: view.bottomAnchor, constant: -12),
+        ])
+    }
+
+    // MARK: - State
+
+    private func refreshUI() {
+        guard let index = levels.firstIndex(of: currentLevel) else {
+            return
+        }
+        slider.value = Float(index)
+        percentLabel.text = PageZoomLevels.displayText(for: currentLevel)
+    }
+
+    private func applyLevel(_ level: Int) {
+        currentLevel = level
+        percentLabel.text = PageZoomLevels.displayText(for: level)
+        onApply?(level)
+    }
+
+    // MARK: - Actions
+
+    @objc private func sliderChanged(_ sender: UISlider) {
+        let index = Int(sender.value.rounded())
+        sender.value = Float(index)
+        applyLevel(levels[index])
+    }
+
+    /// Snaps to the nearest level once the finger lifts, in case the slider was
+    /// still between two steps when `isContinuous` delivered the last value.
+    @objc private func sliderReleased(_ sender: UISlider) {
+        let index = Int(sender.value.rounded())
+        sender.value = Float(index)
+        applyLevel(levels[index])
+    }
+
+    @objc private func backTapped() {
+        dismiss(animated: true)
+    }
+}
