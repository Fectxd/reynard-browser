diff --git a/browser/Reynard/Client/Interface/Library/Settings/Sections/Privacy/Passwords/PasswordsViewController.swift b/browser/Reynard/Client/Interface/Library/Settings/Sections/Privacy/Passwords/PasswordsViewController.swift
