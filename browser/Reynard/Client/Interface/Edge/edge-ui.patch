index 0000000..5f9842c
--- /dev/null
+++ b/browser/Reynard/Client/Interface/Edge/EdgeFontSizeViewController.swift
@@ -0,0 +1,257 @@
+//
+//  EdgeFontSizeViewController.swift
+//  Reynard
+//
+//  Created by Edge UI instrumentation.
+//
+//  Edge-style "Font size" (字体大小) popup. It reads and writes the current
+//  site's page-zoom level (stored per host in SiteSettingsStore) and lets the
+//  user drag a slider between the smallest and the largest supported level.
+//
+//  Layout follows Edge:
+//    < 字体大小                     (header: back chevron + title)
+//      ─────────────────────────
+//      网页字体大小                 (section label)
+//      A  ────●──────  A           (small A, slider, large A)
+//             100%                 (current level)
+//      此字号仅适用于此域中的网站。  (footer note)
+//
+
+import UIKit
+
+final class EdgeFontSizeViewController: UIViewController {
+
+    private enum UX {
+        static let contentWidth: CGFloat = 360
+        static let contentHeight: CGFloat = 236
+        static let blueTint = UIColor(red: 0.0, green: 0.48, blue: 1.0, alpha: 1.0)
+        static let smallAFontSize: CGFloat = 11
+        static let largeAFontSize: CGFloat = 26
+        static let percentFontSize: CGFloat = 17
+        static let noteFontSize: CGFloat = 12
+        static let sectionFontSize: CGFloat = 14
+        static let headerFontSize: CGFloat = 18
+    }
+
+    /// Invoked with the newly selected level; the presenter applies it per-site
+    /// (persisting to SiteSettingsStore and updating the session).
+    var onApply: ((Int) -> Void)?
+
+    /// The zoom levels, in ascending order. The slider maps continuously to the
+    /// index of this array so every step is evenly spaced; the value snaps to
+    /// the nearest level on change (and on release).
+    private let levels = PageZoomLevels.all
+
+    private var currentLevel: Int = Prefs.BrowsingSettings.defaultPageZoomLevel
+
+    // MARK: - View Construction
+
+    private let headerView: UIView = {
+        let view = UIView()
+        view.translatesAutoresizingMaskIntoConstraints = false
+        return view
+    }()
+
+    private lazy var backButton: UIButton = {
+        let button = UIButton(type: .system)
+        button.translatesAutoresizingMaskIntoConstraints = false
+        button.setImage(UIImage(systemName: "chevron.backward"), for: .normal)
+        button.tintColor = UX.blueTint
+        button.addTarget(self, action: #selector(backTapped), for: .touchUpInside)
+        return button
+    }()
+
+    private let titleLabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.text = "字体大小"
+        label.font = .systemFont(ofSize: UX.headerFontSize, weight: .semibold)
+        label.textColor = .label
+        return label
+    }()
+
+    private let topDivider: UIView = {
+        let view = UIView()
+        view.translatesAutoresizingMaskIntoConstraints = false
+        view.backgroundColor = .separator
+        return view
+    }()
+
+    private let sectionLabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.text = "网页字体大小"
+        label.font = .systemFont(ofSize: UX.sectionFontSize, weight: .regular)
+        label.textColor = .label
+        return label
+    }()
+
+    private let smallALabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.text = "A"
+        label.font = .systemFont(ofSize: UX.smallAFontSize, weight: .medium)
+        label.textColor = .secondaryLabel
+        return label
+    }()
+
+    private lazy var slider: UISlider = {
+        let slider = UISlider()
+        slider.translatesAutoresizingMaskIntoConstraints = false
+        slider.minimumValue = 0
+        slider.maximumValue = Float(levels.count - 1)
+        slider.isContinuous = true
+        slider.tintColor = UX.blueTint
+        slider.addTarget(self, action: #selector(sliderChanged(_:)), for: .valueChanged)
+        slider.addTarget(
+            self,
+            action: #selector(sliderReleased(_:)),
+            for: [.touchUpInside, .touchUpOutside, .touchCancel]
+        )
+        return slider
+    }()
+
+    private let largeALabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.text = "A"
+        label.font = .systemFont(ofSize: UX.largeAFontSize, weight: .medium)
+        label.textColor = .label
+        label.setContentHuggingPriority(.required, for: .horizontal)
+        label.setContentCompressionResistancePriority(.required, for: .horizontal)
+        return label
+    }()
+
+    private let percentLabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.font = .systemFont(ofSize: UX.percentFontSize, weight: .medium)
+        label.textColor = .label
+        label.textAlignment = .center
+        return label
+    }()
+
+    private let noteLabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.text = "此字号仅适用于此域中的网站。"
+        label.font = .systemFont(ofSize: UX.noteFontSize, weight: .regular)
+        label.textColor = .secondaryLabel
+        label.textAlignment = .center
+        label.numberOfLines = 0
+        return label
+    }()
+
+    // MARK: - Lifecycle
+
+    init(level: Int? = nil) {
+        if let level, levels.contains(level) {
+            currentLevel = level
+        }
+        super.init(nibName: nil, bundle: nil)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        view.backgroundColor = .systemBackground
+        preferredContentSize = CGSize(width: UX.contentWidth, height: UX.contentHeight)
+        configureHierarchy()
+        configureConstraints()
+        refreshUI()
+    }
+
+    // MARK: - Setup
+
+    private func configureHierarchy() {
+        headerView.addSubview(backButton)
+        headerView.addSubview(titleLabel)
+        [headerView, topDivider, sectionLabel, smallALabel, slider, largeALabel, percentLabel, noteLabel].forEach {
+            view.addSubview($0)
+        }
+    }
+
+    private func configureConstraints() {
+        NSLayoutConstraint.activate([
+            headerView.topAnchor.constraint(equalTo: view.topAnchor),
+            headerView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
+            headerView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+            headerView.heightAnchor.constraint(equalToConstant: 52),
+
+            backButton.leadingAnchor.constraint(equalTo: headerView.leadingAnchor, constant: 12),
+            backButton.centerYAnchor.constraint(equalTo: headerView.centerYAnchor),
+            backButton.widthAnchor.constraint(equalToConstant: 36),
+            backButton.heightAnchor.constraint(equalToConstant: 36),
+
+            titleLabel.leadingAnchor.constraint(equalTo: backButton.trailingAnchor, constant: 6),
+            titleLabel.centerYAnchor.constraint(equalTo: headerView.centerYAnchor),
+            titleLabel.trailingAnchor.constraint(lessThanOrEqualTo: headerView.trailingAnchor, constant: -12),
+
+            topDivider.topAnchor.constraint(equalTo: headerView.bottomAnchor),
+            topDivider.leadingAnchor.constraint(equalTo: view.leadingAnchor),
+            topDivider.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+            topDivider.heightAnchor.constraint(equalToConstant: 0.5),
+
+            sectionLabel.topAnchor.constraint(equalTo: topDivider.bottomAnchor, constant: 12),
+            sectionLabel.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: 20),
+            sectionLabel.trailingAnchor.constraint(lessThanOrEqualTo: view.trailingAnchor, constant: -20),
+
+            smallALabel.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: 20),
+            smallALabel.centerYAnchor.constraint(equalTo: slider.centerYAnchor),
+
+            slider.topAnchor.constraint(equalTo: sectionLabel.bottomAnchor, constant: 12),
+            slider.leadingAnchor.constraint(equalTo: smallALabel.trailingAnchor, constant: 10),
+            slider.trailingAnchor.constraint(equalTo: largeALabel.leadingAnchor, constant: -10),
+
+            largeALabel.trailingAnchor.constraint(equalTo: view.trailingAnchor, constant: -20),
+            largeALabel.centerYAnchor.constraint(equalTo: slider.centerYAnchor),
+
+            percentLabel.topAnchor.constraint(equalTo: slider.bottomAnchor, constant: 6),
+            percentLabel.centerXAnchor.constraint(equalTo: view.centerXAnchor),
+
+            noteLabel.topAnchor.constraint(equalTo: percentLabel.bottomAnchor, constant: 14),
+            noteLabel.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: 20),
+            noteLabel.trailingAnchor.constraint(equalTo: view.trailingAnchor, constant: -20),
+            noteLabel.bottomAnchor.constraint(lessThanOrEqualTo: view.bottomAnchor, constant: -12),
+        ])
+    }
+
+    // MARK: - State
+
+    private func refreshUI() {
+        guard let index = levels.firstIndex(of: currentLevel) else {
+            return
+        }
+        slider.value = Float(index)
+        percentLabel.text = PageZoomLevels.displayText(for: currentLevel)
+    }
+
+    private func applyLevel(_ level: Int) {
+        currentLevel = level
+        percentLabel.text = PageZoomLevels.displayText(for: level)
+        onApply?(level)
+    }
+
+    // MARK: - Actions
+
+    @objc private func sliderChanged(_ sender: UISlider) {
+        let index = Int(sender.value.rounded())
+        sender.value = Float(index)
+        applyLevel(levels[index])
+    }
+
+    /// Snaps to the nearest level once the finger lifts, in case the slider was
+    /// still between two steps when `isContinuous` delivered the last value.
+    @objc private func sliderReleased(_ sender: UISlider) {
+        let index = Int(sender.value.rounded())
+        sender.value = Float(index)
+        applyLevel(levels[index])
+    }
+
+    @objc private func backTapped() {
+        dismiss(animated: true)
+    }
+}
diff --git a/browser/Reynard/Client/Interface/Edge/EdgeLibrarySidePanelController.swift b/browser/Reynard/Client/Interface/Edge/EdgeLibrarySidePanelController.swift
new file mode 100644
index 0000000..c7a61ab
--- /dev/null
+++ b/browser/Reynard/Client/Interface/Edge/EdgeLibrarySidePanelController.swift
@@ -0,0 +1,221 @@
+//
+//  EdgeLibrarySidePanelController.swift
+//  Reynard
+//
+//  Created by Edge UI instrumentation.
+//
+//  True right side-by-side Library panel for the wide (pad) layout. The web
+//  content region is inset from the trailing edge (see BrowserViewController
+//  contentTrailingConstraint) and this panel occupies the vacated strip on the
+//  right. It hosts the existing standalone library sections (收藏夹 / 历史 /
+//  下载) and lets the user switch among them inline, replacing the old modal
+//  UITabBarController whose bottom 收藏/历史/下载/设置 tab bar is no longer used
+//  on the wide layout. Each section keeps its own navigation stack so folder /
+//  item drill-down (Bookmarks folders etc.) still works.
+//
+
+import UIKit
+
+final class EdgeLibrarySidePanelController: UIViewController {
+
+    /// The sections that appear in the side panel (书签 / 历史 / 下载). Settings
+    /// stays in the modal Settings screen and is intentionally excluded.
+    static let panelSections: [LibrarySection] = [.bookmarks, .history, .downloads]
+
+    /// The width (points) the panel occupies on the trailing edge.
+    static let panelWidth: CGFloat = UX.panelWidth
+
+    /// Invoked when the user taps the panel's close button.
+    var onClose: (() -> Void)?
+
+    private enum UX {
+        static let panelWidth: CGFloat = 340
+        static let headerHeight: CGFloat = 52
+        static let segmentedHeight: CGFloat = 32
+        static let segmentedInset: CGFloat = 12
+        static let closeButtonWidth: CGFloat = 44
+        static let fontSize: CGFloat = 15
+    }
+
+    private let sectionItemIdentifiers = EdgeLibrarySidePanelController.panelSections
+
+    /// One UINavigationController per section so drilling into a section does
+    /// not disturb another section's stack.
+    private var navigationControllers: [LibrarySection: UINavigationController] = [:]
+    private weak var activeNavigationController: UINavigationController?
+
+    private let headerView = UIView()
+    private let segmentedControl = UISegmentedControl()
+    private let contentContainerView = UIView()
+
+    // MARK: - Lifecycle
+
+    init() {
+        super.init(nibName: nil, bundle: nil)
+        preferredContentSize = CGSize(width: UX.panelWidth, height: 700)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        view.backgroundColor = .systemGroupedBackground
+        configureHeader()
+        configureContent()
+    }
+
+    private func configureHeader() {
+        headerView.translatesAutoresizingMaskIntoConstraints = false
+        headerView.backgroundColor = .systemBackground
+        view.addSubview(headerView)
+
+        segmentedControl.translatesAutoresizingMaskIntoConstraints = false
+        sectionItemIdentifiers.forEach { section in
+            segmentedControl.insertSegment(
+                withTitle: section.panelTitle,
+                at: segmentedControl.numberOfSegments,
+                animated: false
+            )
+        }
+        segmentedControl.selectedSegmentIndex = 0
+        segmentedControl.setTitleTextAttributes(
+            [.font: UIFont.systemFont(ofSize: UX.fontSize - 1, weight: .semibold)],
+            for: .normal
+        )
+        segmentedControl.addTarget(
+            self,
+            action: #selector(segmentedControlDidChange),
+            for: .valueChanged
+        )
+        headerView.addSubview(segmentedControl)
+
+        let closeButton = UIButton(type: .system)
+        closeButton.translatesAutoresizingMaskIntoConstraints = false
+        closeButton.setImage(UIImage(systemName: "xmark"), for: .normal)
+        closeButton.tintColor = .label
+        closeButton.addTarget(self, action: #selector(closeTapped), for: .touchUpInside)
+        headerView.addSubview(closeButton)
+
+        NSLayoutConstraint.activate([
+            headerView.topAnchor.constraint(equalTo: view.topAnchor),
+            headerView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
+            headerView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+            headerView.heightAnchor.constraint(equalToConstant: UX.headerHeight),
+
+            segmentedControl.leadingAnchor.constraint(equalTo: headerView.leadingAnchor, constant: UX.segmentedInset),
+            segmentedControl.trailingAnchor.constraint(equalTo: closeButton.leadingAnchor, constant: -UX.segmentedInset),
+            segmentedControl.centerYAnchor.constraint(equalTo: headerView.centerYAnchor),
+            segmentedControl.heightAnchor.constraint(equalToConstant: UX.segmentedHeight),
+
+            closeButton.trailingAnchor.constraint(equalTo: headerView.trailingAnchor),
+            closeButton.centerYAnchor.constraint(equalTo: headerView.centerYAnchor),
+            closeButton.widthAnchor.constraint(equalToConstant: UX.closeButtonWidth),
+            closeButton.heightAnchor.constraint(equalToConstant: UX.headerHeight),
+        ])
+    }
+
+    private func configureContent() {
+        contentContainerView.translatesAutoresizingMaskIntoConstraints = false
+        view.addSubview(contentContainerView)
+        NSLayoutConstraint.activate([
+            contentContainerView.topAnchor.constraint(equalTo: headerView.bottomAnchor),
+            contentContainerView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
+            contentContainerView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+            contentContainerView.bottomAnchor.constraint(equalTo: view.bottomAnchor),
+        ])
+    }
+
+    // MARK: - Section Switching
+
+    func showSection(_ section: LibrarySection) {
+        guard sectionItemIdentifiers.contains(section) else {
+            return
+        }
+
+        if let index = sectionItemIdentifiers.firstIndex(of: section) {
+            segmentedControl.selectedSegmentIndex = index
+        }
+
+        let navigationController = navigationController(for: section)
+        guard activeNavigationController !== navigationController else {
+            return
+        }
+
+        if let activeNavigationController {
+            activeNavigationController.willMove(toParent: nil)
+            activeNavigationController.view.removeFromSuperview()
+            activeNavigationController.removeFromParent()
+        }
+
+        addChild(navigationController)
+        navigationController.view.translatesAutoresizingMaskIntoConstraints = false
+        contentContainerView.addSubview(navigationController.view)
+        NSLayoutConstraint.activate([
+            navigationController.view.topAnchor.constraint(equalTo: contentContainerView.topAnchor),
+            navigationController.view.leadingAnchor.constraint(equalTo: contentContainerView.leadingAnchor),
+            navigationController.view.trailingAnchor.constraint(equalTo: contentContainerView.trailingAnchor),
+            navigationController.view.bottomAnchor.constraint(equalTo: contentContainerView.bottomAnchor),
+        ])
+        navigationController.didMove(toParent: self)
+
+        activeNavigationController = navigationController
+    }
+
+    private func navigationController(for section: LibrarySection) -> UINavigationController {
+        if let existing = navigationControllers[section] {
+            return existing
+        }
+        let rootViewController = makeSectionController(for: section)
+        let navigationController = UINavigationController(rootViewController: rootViewController)
+        navigationController.isNavigationBarHidden = false
+        navigationControllers[section] = navigationController
+        return navigationController
+    }
+
+    private func makeSectionController(for section: LibrarySection) -> UIViewController {
+        switch section {
+        case .bookmarks:
+            return BookmarksViewController()
+        case .history:
+            return HistoryViewController()
+        case .downloads:
+            return DownloadsViewController()
+        case .settings:
+            // Never requested for the side panel; keep exhaustive switch.
+            return SettingsViewController()
+        }
+    }
+
+    // MARK: - Actions
+
+    @objc private func segmentedControlDidChange() {
+        let index = segmentedControl.selectedSegmentIndex
+        guard sectionItemIdentifiers.indices.contains(index) else {
+            return
+        }
+        showSection(sectionItemIdentifiers[index])
+    }
+
+    @objc private func closeTapped() {
+        onClose?()
+    }
+}
+
+private extension LibrarySection {
+    /// Chinese labels used by the Edge UI panel (the stock LibrarySection.title
+    /// is the localised English Bookmarks/History/Downloads).
+    var panelTitle: String {
+        switch self {
+        case .bookmarks:
+            return "收藏夹"
+        case .history:
+            return "历史记录"
+        case .downloads:
+            return "下载"
+        case .settings:
+            return "设置"
+        }
+    }
+}
diff --git a/browser/Reynard/Client/Interface/Edge/EdgeMenuViewController.swift b/browser/Reynard/Client/Interface/Edge/EdgeMenuViewController.swift
new file mode 100644
index 0000000..be1ca8e
--- /dev/null
+++ b/browser/Reynard/Client/Interface/Edge/EdgeMenuViewController.swift
@@ -0,0 +1,501 @@
+//
+//  EdgeMenuViewController.swift
+//  Reynard
+//
+//  Created by Edge UI instrumentation.
+//
+//  Edge-style overflow menu (the "≡" button). Behaves adaptively like the
+//  rest of the app:
+//     - wide / regular width  -> a grid of icon + label tiles (matrix)
+//     - narrow / compact      -> a vertical list of icon + label rows
+//
+//  A thin horizontal divider separates the primary (top) group, whose icons
+//  are tinted blue, from the secondary group below it.
+//
+
+import UIKit
+
+final class EdgeMenuViewController: UIViewController, UICollectionViewDelegate, UICollectionViewDataSource, UICollectionViewDelegateFlowLayout {
+
+    /// The full set of menu items, in display order.
+    enum Item: Int, CaseIterable {
+        // Primary group (above the line, tinted blue)
+        case favorites
+        case history
+        case downloads
+        case settings
+
+        // Secondary group (below the line)
+        case home
+        case newInPrivateTab
+        case addToFavorites
+        case requestDesktopWebsite
+        case appearance
+        case clearData
+        case shareExtension
+        case share
+        case sendToDevice
+        case translate
+        case addToPhone
+        case downloadPage
+        case findInPage
+        case fontSize
+        case exitBrowser
+
+        var title: String {
+            switch self {
+            case .favorites:
+                return "收藏夹"
+            case .history:
+                return "历史记录"
+            case .downloads:
+                return "下载"
+            case .settings:
+                return "设置"
+            case .home:
+                return "主页"
+            case .newInPrivateTab:
+                return "新建 InPrivate 标签页"
+            case .addToFavorites:
+                return "添加到收藏夹"
+            case .requestDesktopWebsite:
+                return "查看桌面网页"
+            case .appearance:
+                return "深色/浅色模式"
+            case .clearData:
+                return "删除数据"
+            case .shareExtension:
+                return "拓展"
+            case .share:
+                return "分享"
+            case .sendToDevice:
+                return "发送到设备"
+            case .translate:
+                return "翻译"
+            case .addToPhone:
+                return "二维码分享"
+            case .downloadPage:
+                return "下载此页面"
+            case .findInPage:
+                return "在页面上查找"
+            case .fontSize:
+                return "字体大小"
+            case .exitBrowser:
+                return "退出浏览器"
+            }
+        }
+
+        var symbolName: String {
+            switch self {
+            case .favorites:
+                return "reynard.star"
+            case .history:
+                return "reynard.clock"
+            case .downloads:
+                return "reynard.arrow.down.circle"
+            case .settings:
+                return "reynard.gearshape"
+            case .home:
+                return "reynard.globe"
+            case .newInPrivateTab:
+                return "reynard.plus.square.fill.on.square.fill"
+            case .addToFavorites:
+                return "reynard.book"
+            case .requestDesktopWebsite:
+                return "reynard.desktopcomputer"
+            case .appearance:
+                return "reynard.moon.fill"
+            case .clearData:
+                return "reynard.trash"
+            case .shareExtension:
+                return "reynard.puzzlepiece.extension"
+            case .share:
+                return "reynard.square.and.arrow.up"
+            case .sendToDevice:
+                return "reynard.arrow.up.right"
+            case .translate:
+                return "reynard.globe"
+            case .addToPhone:
+                return "reynard.smartphone"
+            case .downloadPage:
+                return "reynard.square.and.arrow.down"
+            case .findInPage:
+                return "reynard.magnifyingglass"
+            case .fontSize:
+                return "reynard.textformat.size"
+            case .exitBrowser:
+                return "reynard.xmark"
+            }
+        }
+
+        /// The primary (above the line) group keeps a blue tint, matching Edge.
+        var usesPrimaryTint: Bool {
+            switch self {
+            case .favorites, .history, .downloads, .settings:
+                return true
+            default:
+                return false
+            }
+        }
+
+        /// Items with no real implementation yet are rendered with a faded
+        /// icon as a placeholder (to be wired up later).
+        var isUnavailablePlaceholder: Bool {
+            // All currently displayed items are wired up; nothing is a
+            // placeholder anymore.
+            return false
+        }
+    }
+
+    private enum UX {
+        static let primarySymbolPointSize: CGFloat = 26
+        static let secondarySymbolPointSize: CGFloat = 22
+        static let gridItemSpacing: CGFloat = 6
+        static let gridContentInset: CGFloat = 8
+        // Keep enough vertical room so two-line tile titles are not clipped.
+        static let gridGroupHeight: CGFloat = 104
+        static let listRowHeight: CGFloat = 56
+        static let blueTint = UIColor(red: 0.0, green: 0.48, blue: 1.0, alpha: 1.0)
+    }
+
+    /// Invoked with the selected item; the presenter decides the action and
+    /// dismisses this controller.
+    var onSelect: ((Item) -> Void)?
+
+    /// Lets the presenter override an item's title (e.g. the desktop/mobile
+    /// website toggle label depends on the current mode).
+    var titleOverride: ((Item) -> String?)?
+    /// Lets the presenter override an item's symbol.
+    var symbolOverride: ((Item) -> String?)?
+
+    private func displayTitle(for item: Item) -> String {
+        return titleOverride?(item) ?? item.title
+    }
+
+    private func displaySymbol(for item: Item) -> String {
+        return symbolOverride?(item) ?? item.symbolName
+    }
+
+    private enum Section: Int, CaseIterable {
+        case primary
+        case secondary
+    }
+
+    private let cellReuseIdentifier = "EdgeMenuCell"
+    private let dividerReuseIdentifier = "EdgeMenuDivider"
+
+    private lazy var collectionView: UICollectionView = {
+        let layout = UICollectionViewFlowLayout()
+        let view = UICollectionView(frame: .zero, collectionViewLayout: layout)
+        view.translatesAutoresizingMaskIntoConstraints = false
+        view.backgroundColor = .systemBackground
+        view.delegate = self
+        view.dataSource = self
+        view.alwaysBounceVertical = true
+        return view
+    }()
+
+    /// The presenter shows this menu as a popover exactly when the window is
+    /// in the wide (pad) layout (window width >= the chrome threshold), and as
+    /// a pageSheet otherwise. A popover's internal trait collection can report
+    /// a compact horizontal size class even inside a wide window, which made
+    /// the grid never activate here, so the choice is keyed off the actual
+    /// presentation style instead of the trait collection.
+    private var isWideLayout: Bool {
+        return modalPresentationStyle == .popover
+    }
+
+    // MARK: - Lifecycle
+
+    init() {
+        super.init(nibName: nil, bundle: nil)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        view.backgroundColor = .systemBackground
+        view.addSubview(collectionView)
+        NSLayoutConstraint.activate([
+            collectionView.topAnchor.constraint(equalTo: view.topAnchor),
+            collectionView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
+            collectionView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
+            collectionView.bottomAnchor.constraint(equalTo: view.bottomAnchor),
+        ])
+        collectionView.register(EdgeMenuCell.self, forCellWithReuseIdentifier: cellReuseIdentifier)
+        collectionView.register(
+            UICollectionReusableView.self,
+            forSupplementaryViewOfKind: UICollectionView.elementKindSectionHeader,
+            withReuseIdentifier: dividerReuseIdentifier
+        )
+        if isWideLayout {
+            // The popover opens at the presenter-requested size; make sure it
+            // is tall enough for the entire fixed 4-column grid so the menu
+            // never turns into a scrolling column inside the popover.
+            preferredContentSize = CGSize(width: 300, height: gridContentHeight)
+        }
+    }
+
+    override func viewWillAppear(_ animated: Bool) {
+        super.viewWillAppear(animated)
+        collectionView.reloadData()
+    }
+
+    /// Exact height of the wide 4-column grid: one primary row + the rows the
+    /// secondary group wraps into, plus inter-row spacing, the per-section
+    /// vertical insets and the 1pt divider between the groups.
+    private var gridContentHeight: CGFloat {
+        let columnCount = 4
+        let secondaryRowCount = (items(in: .secondary).count + columnCount - 1) / columnCount
+        let totalRowCount = 1 + secondaryRowCount // primary is exactly one row
+        let interRowSpacing = CGFloat(max(0, secondaryRowCount - 1)) * UX.gridItemSpacing
+        let sectionVerticalInsets = (UX.gridContentInset * 2) * CGFloat(Section.allCases.count)
+        return CGFloat(totalRowCount) * UX.gridGroupHeight
+            + interRowSpacing
+            + sectionVerticalInsets
+            + 1 // divider
+    }
+
+    override func traitCollectionDidChange(_ previousTraitCollection: UITraitCollection?) {
+        super.traitCollectionDidChange(previousTraitCollection)
+        guard previousTraitCollection?.horizontalSizeClass != traitCollection.horizontalSizeClass else {
+            return
+        }
+        collectionView.collectionViewLayout.invalidateLayout()
+        collectionView.reloadData()
+    }
+
+    // MARK: - Data
+
+    private func items(in section: Section) -> [Item] {
+        switch section {
+        case .primary:
+            return [.favorites, .history, .downloads, .settings]
+        case .secondary:
+            return [
+                .home, .newInPrivateTab, .addToFavorites, .requestDesktopWebsite,
+                .appearance, .clearData, .shareExtension, .share, .translate,
+                .addToPhone, .findInPage, .fontSize, .exitBrowser,
+            ]
+        }
+    }
+
+    // MARK: - UICollectionViewDataSource
+
+    func numberOfSections(in collectionView: UICollectionView) -> Int {
+        return Section.allCases.count
+    }
+
+    func collectionView(_ collectionView: UICollectionView, numberOfItemsInSection section: Int) -> Int {
+        guard let menuSection = Section(rawValue: section) else {
+            return 0
+        }
+        return items(in: menuSection).count
+    }
+
+    func collectionView(_ collectionView: UICollectionView, cellForItemAt indexPath: IndexPath) -> UICollectionViewCell {
+        let cell = collectionView.dequeueReusableCell(withReuseIdentifier: cellReuseIdentifier, for: indexPath) as! EdgeMenuCell
+        guard let menuSection = Section(rawValue: indexPath.section) else {
+            return cell
+        }
+        let item = items(in: menuSection)[indexPath.row]
+        cell.configure(
+            title: displayTitle(for: item),
+            symbolName: displaySymbol(for: item),
+            tint: item.usesPrimaryTint ? UX.blueTint : .label,
+            usesPrimaryTint: item.usesPrimaryTint,
+            symbolPointSize: item.usesPrimaryTint ? UX.primarySymbolPointSize : UX.secondarySymbolPointSize,
+            wideLayout: isWideLayout,
+            isPlaceholder: item.isUnavailablePlaceholder
+        )
+        return cell
+    }
+
+    // MARK: - UICollectionViewDelegate
+
+    func collectionView(_ collectionView: UICollectionView, didSelectItemAt indexPath: IndexPath) {
+        collectionView.deselectItem(at: indexPath, animated: true)
+        guard let menuSection = Section(rawValue: indexPath.section) else {
+            return
+        }
+        let items = items(in: menuSection)
+        guard items.indices.contains(indexPath.row) else {
+            return
+        }
+        onSelect?(items[indexPath.row])
+    }
+
+    // MARK: - UICollectionViewDelegateFlowLayout
+
+    func collectionView(
+        _ collectionView: UICollectionView,
+        layout collectionViewLayout: UICollectionViewLayout,
+        insetForSectionAt section: Int
+    ) -> UIEdgeInsets {
+        let horizontalInset: CGFloat = isWideLayout ? UX.gridContentInset : 0
+        return UIEdgeInsets(top: UX.gridContentInset, left: horizontalInset, bottom: UX.gridContentInset, right: horizontalInset)
+    }
+
+    func collectionView(
+        _ collectionView: UICollectionView,
+        layout collectionViewLayout: UICollectionViewLayout,
+        minimumLineSpacingForSectionAt section: Int
+    ) -> CGFloat {
+        return isWideLayout ? UX.gridItemSpacing : 0
+    }
+
+    func collectionView(
+        _ collectionView: UICollectionView,
+        layout collectionViewLayout: UICollectionViewLayout,
+        minimumInteritemSpacingForSectionAt section: Int
+    ) -> CGFloat {
+        return isWideLayout ? UX.gridItemSpacing : 0
+    }
+
+    func collectionView(
+        _ collectionView: UICollectionView,
+        layout collectionViewLayout: UICollectionViewLayout,
+        sizeForItemAt indexPath: IndexPath
+    ) -> CGSize {
+        let availableWidth = collectionView.bounds.width - (isWideLayout ? (UX.gridContentInset * 2) : 0)
+        if isWideLayout {
+            // A fixed 4-column grid (4 x N) in wide / landscape layout, like a
+            // compact app drawer.
+            let columnCount = 4
+            let itemWidth = (availableWidth - (CGFloat(columnCount - 1) * UX.gridItemSpacing)) / CGFloat(columnCount)
+            return CGSize(width: itemWidth, height: UX.gridGroupHeight)
+        }
+        return CGSize(width: availableWidth, height: UX.listRowHeight)
+    }
+
+    func collectionView(
+        _ collectionView: UICollectionView,
+        layout collectionViewLayout: UICollectionViewLayout,
+        referenceSizeForHeaderInSection section: Int
+    ) -> CGSize {
+        guard let menuSection = Section(rawValue: section), menuSection == .secondary else {
+            return .zero
+        }
+        return CGSize(width: collectionView.bounds.width, height: 1)
+    }
+
+    func collectionView(
+        _ collectionView: UICollectionView,
+        viewForSupplementaryElementOfKind kind: String,
+        at indexPath: IndexPath
+    ) -> UICollectionReusableView {
+        guard kind == UICollectionView.elementKindSectionHeader else {
+            return UICollectionReusableView()
+        }
+        let header = collectionView.dequeueReusableSupplementaryView(
+            ofKind: kind,
+            withReuseIdentifier: dividerReuseIdentifier,
+            for: indexPath
+        )
+        header.backgroundColor = .separator
+        return header
+    }
+}
+
+/// A single tile (grid) or row (list) in the Edge menu.
+final class EdgeMenuCell: UICollectionViewCell {
+
+    private let titleLabel: UILabel = {
+        let label = UILabel()
+        label.translatesAutoresizingMaskIntoConstraints = false
+        label.textAlignment = .center
+        label.font = .systemFont(ofSize: 13, weight: .medium)
+        label.numberOfLines = 2
+        return label
+    }()
+
+    private let symbolView: UIImageView = {
+        let view = UIImageView()
+        view.translatesAutoresizingMaskIntoConstraints = false
+        view.contentMode = .center
+        return view
+    }()
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        contentView.backgroundColor = .clear
+        contentView.layer.cornerRadius = 12
+        contentView.layer.cornerCurve = .continuous
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    private var wideConstraints: [NSLayoutConstraint] = []
+    private var listConstraints: [NSLayoutConstraint] = []
+
+    func configure(
+        title: String,
+        symbolName: String,
+        tint: UIColor,
+        usesPrimaryTint: Bool,
+        symbolPointSize: CGFloat,
+        wideLayout: Bool,
+        isPlaceholder: Bool
+    ) {
+        titleLabel.text = title
+        titleLabel.textColor = tint
+
+        let configuration = UIImage.SymbolConfiguration(pointSize: symbolPointSize, weight: usesPrimaryTint ? .medium : .regular)
+        symbolView.image = UIImage(named: symbolName, in: .main, with: configuration)
+        symbolView.tintColor = tint
+
+        let alpha: CGFloat = isPlaceholder ? 0.4 : 1
+        symbolView.alpha = alpha
+        titleLabel.alpha = alpha
+
+        // No tile background: Edge shows plain icon + label (only a selection
+        // tint on highlight), keeping the menu light.
+        contentView.backgroundColor = .clear
+
+        applyLayout(wideLayout: wideLayout)
+    }
+
+    private func applyLayout(wideLayout: Bool) {
+        if contentView.subviews.isEmpty {
+            contentView.addSubview(symbolView)
+            contentView.addSubview(titleLabel)
+        }
+
+        NSLayoutConstraint.deactivate(wideConstraints + listConstraints)
+        wideConstraints = []
+        listConstraints = []
+
+        if wideLayout {
+            wideConstraints = [
+                symbolView.centerXAnchor.constraint(equalTo: contentView.centerXAnchor),
+                symbolView.topAnchor.constraint(equalTo: contentView.topAnchor, constant: 16),
+                symbolView.widthAnchor.constraint(equalToConstant: 44),
+                symbolView.heightAnchor.constraint(equalToConstant: 44),
+
+                titleLabel.topAnchor.constraint(equalTo: symbolView.bottomAnchor, constant: 8),
+                titleLabel.leadingAnchor.constraint(equalTo: contentView.leadingAnchor, constant: 4),
+                titleLabel.trailingAnchor.constraint(equalTo: contentView.trailingAnchor, constant: -4),
+                titleLabel.bottomAnchor.constraint(lessThanOrEqualTo: contentView.bottomAnchor, constant: -8),
+            ]
+            NSLayoutConstraint.activate(wideConstraints)
+        } else {
+            listConstraints = [
+                symbolView.leadingAnchor.constraint(equalTo: contentView.leadingAnchor, constant: 20),
+                symbolView.centerYAnchor.constraint(equalTo: contentView.centerYAnchor),
+                symbolView.widthAnchor.constraint(equalToConstant: 40),
+                symbolView.heightAnchor.constraint(equalToConstant: 40),
+
+                titleLabel.leadingAnchor.constraint(equalTo: symbolView.trailingAnchor, constant: 16),
+                titleLabel.trailingAnchor.constraint(equalTo: contentView.trailingAnchor, constant: -16),
+                titleLabel.centerYAnchor.constraint(equalTo: contentView.centerYAnchor),
+            ]
+            titleLabel.textAlignment = .natural
+            NSLayoutConstraint.activate(listConstraints)
+        }
+    }
+}
